# ── backend/.dockerignore ─────────────────────────────────────────────────────
# Applied when `docker build` runs with context = ./backend
# ──────────────────────────────────────────────────────────────────────────────

# Python cache & virtual envs
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.venv
venv
env

# Secrets
.env
.env.*
!.env.example

# Uploaded media (volume-mounted at runtime)
uploads/*

# Documentation
docs/*.docx
docs/*.pdf

# ML artefacts
*.pt
*.pth
*.onnx
*.h5
*.keras
*.task
*.joblib
*.pkl

# Logs & temp
*.log
logs/
*.tmp
*.temp

# OS
.DS_Store
Thumbs.db
