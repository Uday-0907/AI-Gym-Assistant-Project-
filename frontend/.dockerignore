# ── frontend/.dockerignore ────────────────────────────────────────────────────
# Applied when `docker build` runs with context = ./frontend
# ──────────────────────────────────────────────────────────────────────────────

# Node modules (installed fresh inside the build)
node_modules

# Next.js build output (rebuilt inside Docker)
.next
out

# Secrets
.env
.env.*
!.env.example
!.env.local.example

# Documentation
docs/*.docx

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
*.tmp

# OS
.DS_Store
Thumbs.db
